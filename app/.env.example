# Supabase project settings — find these in your Supabase dashboard under
# Project Settings > API.
#
# NEXT_PUBLIC_SUPABASE_URL      The project URL, e.g. https://abcdefgh.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY The public "anon" API key (safe for the browser;
#                               row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
